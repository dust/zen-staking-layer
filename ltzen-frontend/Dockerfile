# syntax=docker/dockerfile:1

FROM node:22-alpine AS deps
WORKDIR /app
# c-kzg (via viem/ethereum stack) needs node-gyp → python3 + build toolchain inside the image.
# Host Ubuntu Python is irrelevant; this stage runs in Alpine.
RUN apk add --no-cache libc6-compat python3 make g++ \
  && ln -sf python3 /usr/bin/python
ENV PYTHON=/usr/bin/python3
COPY package.json package-lock.json ./
# postinstall patches rrelayer header — must exist before `npm ci`
COPY scripts/patch-rrelayer-header.js ./scripts/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Idempotent: ensure header patch is applied even if deps layer was cached
RUN node scripts/patch-rrelayer-header.js

# Client-exposed vars must be present at `next build` time.
ARG NEXT_PUBLIC_WC_PROJECT_ID
ARG NEXT_PUBLIC_USE_RELAYER_BFF=1
ARG NEXT_PUBLIC_HORIZEN_RPC_URL
ARG NEXT_PUBLIC_HORIZEN_EXPLORER_URL
ARG NEXT_PUBLIC_HORIZEN_STLIGHTER_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_LTZEN_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_ZENSTAKER_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_INBOUND_STATION_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_EGRESS_STATION_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_ZEN_OFT_STATION_BRIDGE_ADDRESS
ARG NEXT_PUBLIC_BASE_CHAIN_ID
ARG NEXT_PUBLIC_BASE_CHAIN_NAME
ARG NEXT_PUBLIC_BASE_RPC_URL
ARG NEXT_PUBLIC_BASE_EXPLORER_URL
ARG NEXT_PUBLIC_BASE_LTZEN_ADDRESS
ARG NEXT_PUBLIC_BASE_ZEN_ADDRESS
ARG NEXT_PUBLIC_BASE_ZEN_OFT_ADAPTER_ADDRESS
ARG NEXT_PUBLIC_HORIZEN_EID
ARG NEXT_PUBLIC_BASE_EID
ARG NEXT_PUBLIC_RELAYER_FEE_ADDRESS
ARG NEXT_PUBLIC_HERO_RATE_UNITS=1000
ARG NEXT_PUBLIC_SUBGRAPH_URL
ARG NEXT_PUBLIC_NETWORK_ENV

ENV NEXT_PUBLIC_WC_PROJECT_ID=$NEXT_PUBLIC_WC_PROJECT_ID \
    NEXT_PUBLIC_USE_RELAYER_BFF=$NEXT_PUBLIC_USE_RELAYER_BFF \
    NEXT_PUBLIC_NETWORK_ENV=$NEXT_PUBLIC_NETWORK_ENV \
    NEXT_PUBLIC_HORIZEN_RPC_URL=$NEXT_PUBLIC_HORIZEN_RPC_URL \
    NEXT_PUBLIC_HORIZEN_EXPLORER_URL=$NEXT_PUBLIC_HORIZEN_EXPLORER_URL \
    NEXT_PUBLIC_HORIZEN_STLIGHTER_ADDRESS=$NEXT_PUBLIC_HORIZEN_STLIGHTER_ADDRESS \
    NEXT_PUBLIC_HORIZEN_LTZEN_ADDRESS=$NEXT_PUBLIC_HORIZEN_LTZEN_ADDRESS \
    NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS=$NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS \
    NEXT_PUBLIC_HORIZEN_ZENSTAKER_ADDRESS=$NEXT_PUBLIC_HORIZEN_ZENSTAKER_ADDRESS \
    NEXT_PUBLIC_HORIZEN_INBOUND_STATION_ADDRESS=$NEXT_PUBLIC_HORIZEN_INBOUND_STATION_ADDRESS \
    NEXT_PUBLIC_HORIZEN_EGRESS_STATION_ADDRESS=$NEXT_PUBLIC_HORIZEN_EGRESS_STATION_ADDRESS \
    NEXT_PUBLIC_HORIZEN_ZEN_OFT_STATION_BRIDGE_ADDRESS=$NEXT_PUBLIC_HORIZEN_ZEN_OFT_STATION_BRIDGE_ADDRESS \
    NEXT_PUBLIC_BASE_CHAIN_ID=$NEXT_PUBLIC_BASE_CHAIN_ID \
    NEXT_PUBLIC_BASE_CHAIN_NAME=$NEXT_PUBLIC_BASE_CHAIN_NAME \
    NEXT_PUBLIC_BASE_RPC_URL=$NEXT_PUBLIC_BASE_RPC_URL \
    NEXT_PUBLIC_BASE_EXPLORER_URL=$NEXT_PUBLIC_BASE_EXPLORER_URL \
    NEXT_PUBLIC_BASE_LTZEN_ADDRESS=$NEXT_PUBLIC_BASE_LTZEN_ADDRESS \
    NEXT_PUBLIC_BASE_ZEN_ADDRESS=$NEXT_PUBLIC_BASE_ZEN_ADDRESS \
    NEXT_PUBLIC_BASE_ZEN_OFT_ADAPTER_ADDRESS=$NEXT_PUBLIC_BASE_ZEN_OFT_ADAPTER_ADDRESS \
    NEXT_PUBLIC_HORIZEN_EID=$NEXT_PUBLIC_HORIZEN_EID \
    NEXT_PUBLIC_BASE_EID=$NEXT_PUBLIC_BASE_EID \
    NEXT_PUBLIC_RELAYER_FEE_ADDRESS=$NEXT_PUBLIC_RELAYER_FEE_ADDRESS \
    NEXT_PUBLIC_HERO_RATE_UNITS=$NEXT_PUBLIC_HERO_RATE_UNITS \
    NEXT_PUBLIC_SUBGRAPH_URL=$NEXT_PUBLIC_SUBGRAPH_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
