# ltZEN dApp — environment template (frontend-plan §1/§2). Copy to .env.local and fill.
# All client-exposed vars MUST be prefixed NEXT_PUBLIC_. Addresses bind to PROXY contracts.

# ---- WalletConnect (required by RainbowKit getDefaultConfig) ----
# Get a projectId from https://cloud.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_WC_PROJECT_ID=fe1fa83f2d8ae9c7541faf6eb5ba07cc

# ---- Horizen Testnet (hub: deposit / redeem / rate / transparency) ----
# Chain id is fixed at 2651420; RPC/explorer have defaults but can be overridden.
NEXT_PUBLIC_HORIZEN_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
NEXT_PUBLIC_HORIZEN_EXPLORER_URL=https://horizen.calderaexplorer.xyz
NEXT_PUBLIC_HORIZEN_STLIGHTER_ADDRESS=0xEaAF6a0CF959D0C8b18A79289F4b7c1ce16E41c6
NEXT_PUBLIC_HORIZEN_LTZEN_ADDRESS=0xF91e475D62E6181C630bf70bCd8564c29b03486B
NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS=0x3909EBEE55aa57Cd7b2ce4c05e57C24f7499203A
NEXT_PUBLIC_HORIZEN_ZENSTAKER_ADDRESS=0xb1E4021B36Ad51AE548B2065Bc55A3BACa33187e

# ---- Base (spoke: ltZEN OFT circulation + gasless only; no deposit/redeem) ----
# chainId/RPC/explorer 待填 — defaults to Base Sepolia (84532) until set.
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BASE_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_BASE_LTZEN_ADDRESS=

# ---- Relayer (abstract gasless layer; comma-separated candidate endpoints) ----
NEXT_PUBLIC_RELAYER_ENDPOINTS=
