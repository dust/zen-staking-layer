# ltZEN dApp — environment template (frontend-plan §1/§2). Copy to .env.local and fill.
# All client-exposed vars MUST be prefixed NEXT_PUBLIC_. Addresses bind to PROXY contracts.

# ---- Network mode (drives Horizen + Base defaults in src/config/chains.ts) ----
# testnet → Horizen 2651420 + Base Sepolia 84532
# mainnet → Horizen 26514 + Base 8453
# If unset, inferred from NEXT_PUBLIC_BASE_CHAIN_ID (84532 → testnet, else mainnet).
NEXT_PUBLIC_NETWORK_ENV=testnet

# ---- WalletConnect (required by RainbowKit getDefaultConfig) ----
# Get a projectId from https://cloud.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_WC_PROJECT_ID=fe1fa83f2d8ae9c7541faf6eb5ba07cc

# ---- Horizen Testnet (hub: deposit / redeem / rate / transparency) ----
# Defaults follow NETWORK_ENV; override id/RPC/explorer when needed.
# NEXT_PUBLIC_HORIZEN_CHAIN_ID=2651420
NEXT_PUBLIC_HORIZEN_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
NEXT_PUBLIC_HORIZEN_EXPLORER_URL=https://horizen-testnet.explorer.caldera.xyz
NEXT_PUBLIC_HORIZEN_STLIGHTER_ADDRESS=0xEaAF6a0CF959D0C8b18A79289F4b7c1ce16E41c6
NEXT_PUBLIC_HORIZEN_LTZEN_ADDRESS=0xF91e475D62E6181C630bf70bCd8564c29b03486B
NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS=0x3909EBEE55aa57Cd7b2ce4c05e57C24f7499203A
NEXT_PUBLIC_HORIZEN_ZENSTAKER_ADDRESS=0xb1E4021B36Ad51AE548B2065Bc55A3BACa33187e
# InboundStation (cross-chain stake credit); leave empty until deployed
NEXT_PUBLIC_HORIZEN_INBOUND_STATION_ADDRESS=
# EgressStation + ZenOftStationBridge (Redeem to Base / Wave B)
NEXT_PUBLIC_HORIZEN_EGRESS_STATION_ADDRESS=
NEXT_PUBLIC_HORIZEN_ZEN_OFT_STATION_BRIDGE_ADDRESS=
# Horizen ZenTokenOFT — omit to reuse NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS (native OFT)
# NEXT_PUBLIC_HORIZEN_ZEN_OFT_ADDRESS=

# ---- Base (spoke: ltZEN OFT + cross-chain ZEN via OFTAdapter) ----
# Defaults follow NETWORK_ENV (testnet → Base Sepolia 84532).
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BASE_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_BASE_LTZEN_ADDRESS=
# Base ZEN is a plain ERC20 (not an OFT) — required for balance + approve
NEXT_PUBLIC_BASE_ZEN_ADDRESS=
# Existing ZenTokenOFTAdapter (OFTAdapter) — locks Base ZEN on send
NEXT_PUBLIC_BASE_ZEN_OFT_ADAPTER_ADDRESS=
# Legacy alias for the adapter (still accepted if ADAPTER unset):
# NEXT_PUBLIC_BASE_ZEN_OFT_ADDRESS=

# LayerZero V2 endpoint IDs (SendParam.dstEid). Fill from ZenTokenOFT / Adapter / LZ docs.
NEXT_PUBLIC_HORIZEN_EID=
NEXT_PUBLIC_BASE_EID=
# ---- Relayer (gasless) ----
# Option A — BFF + rrelayer (recommended for true gasless; secrets server-only):
NEXT_PUBLIC_USE_RELAYER_BFF=
# Local: http://localhost:8000
# Self-hosted compose (deploy/): http://rrelayer:8000  — see deploy/README.md
RRELAYER_SERVER_URL=http://localhost:8000
RRELAYER_RELAYER_ID=
RRELAYER_PROVIDER_URL=https://horizen-testnet.rpc.caldera.xyz/http
# Prefer scoped API key for BFF. Basic auth is admin/CLI only.
RRELAYER_API_KEY=
# Local admin / bootstrap only:
# RRELAYER_AUTH_USERNAME=
# RRELAYER_AUTH_PASSWORD=
# Deprecated: do not use as primary pricing. Prefer FEE_PROFIT_BPS.
# RELAYER_FEE_BPS=50
# Cost-oriented gasless fees (docs/stLighter-gasless-fee-spec.md):
# 1 ETH = ZEN_PER_ETH_FLOOR / 1e18 ZEN (required fallback when live FX fails)
# ~450 ZEN/ETH (slightly below Slipstream spot ~490); refresh periodically
ZEN_PER_ETH_FLOOR=450000000000000000000
PRICE_PROVIDER=aerodrome
BASE_PRICE_RPC_URL=https://mainnet.base.org
# Deep Slipstream ZEN/WETH 0.15% (default in code). Do NOT use thin vAMM pair.
# AERODROME_ZEN_WETH_POOL=0x0392b12a1ceb0cd13af5ea448cf5586ea609852d
# AERODROME_ZEN_ADDRESS=0xf43eb8de897fbc7f2502483b2bef7bb9ea179229
# Optional: PRICE_PROVIDER=coingecko  (ids=zencash,ethereum)
# PRICE_API_KEY=
# PRICE_API_URL=
QUOTE_TTL_SEC=60
PRICE_DEVIATION_BPS=3000
FEE_BUFFER_BPS=1500
FEE_MARGIN_BPS=0
FEE_PROFIT_BPS=0
# RELAY_GAS_LIMIT_DEPOSIT_WITH_SIG=350000
# RELAY_GAS_LIMIT_REDEEM_WITH_SIG=320000
# RELAY_GAS_LIMIT_REDEEM_AND_CREDIT=380000
# RELAY_GAS_LIMIT_BRIDGE_TO_BASE=450000
# GAS_PRICE_PROVIDER_URL=http://localhost:8787
# Fee recipient bound into gasless EIP-712 (`relayer`). Must equal the rrelayer EOA when using BFF.
NEXT_PUBLIC_RELAYER_FEE_ADDRESS=

# Relay debug (dev: on by default on server; set =1 for verbose poll traces)
RELAY_DEBUG=1
# NEXT_PUBLIC_RELAY_DEBUG=1

# Option B — external HTTP relay gateway (comma-separated):
NEXT_PUBLIC_RELAYER_ENDPOINTS=

# Option C — dev without rrelayer (default): DirectContractRelayer — user wallet sends one tx.
# Option D — pure UI mock:
NEXT_PUBLIC_MOCK_RELAYER_ONLY=
NEXT_PUBLIC_MOCK_RELAYER_TIMEOUT=

# ---- Display tuning ----
# HeroRate quotes the value of N ltZEN (default 1000 = 10^DECIMALS_OFFSET) so the headline sits
# near 1.0 and the live per-block movement is visible. Set to 1 to quote a single ltZEN.
NEXT_PUBLIC_HERO_RATE_UNITS=1000
