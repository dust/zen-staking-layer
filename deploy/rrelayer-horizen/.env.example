# Copy to .env and fill in. Never commit real secrets.
#
# Postgres (compose-internal only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=postgres
# Optional: host-side tools only (psql). Runtime rrelayer uses compose override to postgresql:5432.
# DATABASE_URL=postgresql://postgres:change-me-strong@localhost:5432/postgres

# Relayer wallet seed — keep off shared disks; restrict file perms (chmod 600).
RAW_DANGEROUS_MNEMONIC="word1 word2 ... word24"

# Admin basic auth (VPS / CLI only — create relayers, manage config).
# Do NOT put these in Vercel.
RRELAYER_AUTH_USERNAME=admin-user
RRELAYER_AUTH_PASSWORD=change-me-strong

# Scoped API key for the BFF (also referenced from rrelayer.yaml networks[].api_keys).
# Generate inside Docker (does NOT auto-write .env — paste the output yourself):
#   docker compose exec rrelayer rrelayer auth gen-api-key -p /app/project
#   # or: docker run --rm -v "$PWD:/app/project" ghcr.io/joshstevens19/rrelayer auth gen-api-key -p /app/project
RRELAYER_API_KEY=paste-from-rrelayer-auth-gen-api-key
# Relayer EOA address (0x...) from POST /relayers/{chainId}/new — used in yaml api_keys.relayer
RRELAYER_EOA_ADDRESS=0xYourRelayerAddress

# Dynamic CUSTOM gas provider (gas-stub → ../gas-provider)
# Defaults match Horizen live tip (~0.001 Gwei).
GAS_RPC_2651420=https://horizen-testnet.rpc.caldera.xyz/http
GAS_RPC_26514=https://horizen.calderachain.xyz/http
GAS_CACHE_TTL_SECONDS=10
GAS_FLOOR_PRIORITY_WEI=1000000
GAS_CEIL_PRIORITY_WEI=1000000000
GAS_CEIL_MAX_FEE_WEI=5000000000
# IMAGE_TAG=latest

# Project path mounted into the rrelayer container (defaults to compose dir).
# PROJECT_PATH=.
