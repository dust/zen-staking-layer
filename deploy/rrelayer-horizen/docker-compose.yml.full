# Legacy / minimal compose (postgres + rrelayer only). Prefer docker-compose.yml
# for production (nginx TLS edge, no public 8000/Postgres).

volumes:
  postgres_data:
    driver: local

services:
  postgresql:
    image: postgres:16
    container_name: rrelayer-db
    shm_size: 1g
    restart: always
    volumes:
      - postgres_data:/var/lib/postgresql/data
    env_file:
      - ./.env
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 5

  rrelayer:
    image: ghcr.io/joshstevens19/rrelayer
    container_name: rrelayer-service
    restart: always
    volumes:
      - ${PROJECT_PATH:-.}:/app/project
    command: start
    # Loopback only — for local admin; production should use nginx :443 instead.
    ports:
      - "127.0.0.1:8000:8000"
    env_file:
      - ./.env
    environment:
      - DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgresql:5432/${POSTGRES_DB}
      - HOST=0.0.0.0
      - RRELAYER_PORT=8000
    depends_on:
      postgresql:
        condition: service_healthy
