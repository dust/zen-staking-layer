# Unified stack secrets + public config. Copy to .env and fill.
#   cp .env.example .env && chmod 600 .env
#
# Architecture:
#   LAN edge nginx (https://staking.lighter.im) → this host FRONTEND_BIND:FRONTEND_PORT
#   → frontend → rrelayer (compose network) → gas-stub / postgres

# ---- Frontend publish (for the *other* nginx reverse-proxy) ----
# Same host as edge nginx: keep 127.0.0.1. Other LAN host: use 0.0.0.0 (or the LAN IP).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=6000
IMAGE_TAG=latest

# ---- Postgres (internal only) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=postgres

# ---- rrelayer wallet + admin ----
RAW_DANGEROUS_MNEMONIC="word1 word2 ... word24"
RRELAYER_AUTH_USERNAME=admin-user
RRELAYER_AUTH_PASSWORD=change-me-strong
# make gen-api-key  → paste here; also set EOA from POST /relayers/{chainId}/new
RRELAYER_API_KEY=
RRELAYER_EOA_ADDRESS=0xYourRelayerAddress
RRELAYER_RELAYER_ID=
# BFF default inside compose (override only if you know what you are doing)
RRELAYER_SERVER_URL=http://rrelayer:8000
RRELAYER_PROVIDER_URL=https://horizen-testnet.rpc.caldera.xyz/http
RELAYER_FEE_BPS=50

# ---- Frontend (NEXT_PUBLIC_* baked at image build) ----
NEXT_PUBLIC_USE_RELAYER_BFF=1
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_HORIZEN_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
NEXT_PUBLIC_HORIZEN_EXPLORER_URL=https://horizen-testnet.explorer.caldera.xyz
NEXT_PUBLIC_HORIZEN_STLIGHTER_ADDRESS=
NEXT_PUBLIC_HORIZEN_LTZEN_ADDRESS=
NEXT_PUBLIC_HORIZEN_ZEN_ADDRESS=
NEXT_PUBLIC_HORIZEN_ZENSTAKER_ADDRESS=
NEXT_PUBLIC_HORIZEN_INBOUND_STATION_ADDRESS=
NEXT_PUBLIC_HORIZEN_EGRESS_STATION_ADDRESS=
NEXT_PUBLIC_HORIZEN_ZEN_OFT_STATION_BRIDGE_ADDRESS=
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BASE_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_BASE_LTZEN_ADDRESS=
NEXT_PUBLIC_BASE_ZEN_ADDRESS=
NEXT_PUBLIC_BASE_ZEN_OFT_ADAPTER_ADDRESS=
NEXT_PUBLIC_HORIZEN_EID=
NEXT_PUBLIC_BASE_EID=
NEXT_PUBLIC_RELAYER_FEE_ADDRESS=
NEXT_PUBLIC_HERO_RATE_UNITS=1000

# Optional debug
RELAY_DEBUG=0
