# Foundry / stLighter deploy env — copy to `.env` (never commit secrets).
# Full order: docs/stLighter-deploy-checklist.md (Base Sepolia ↔ Horizen Testnet).

MAINNET_RPC_URL=
FOUNDRY_PROFILE=default
DEPLOYER_PRIVATE_KEY=
PROPOSER_ADDRESS=

# =============================================================================
# Shared
# =============================================================================
# Deployer key for ALL forge scripts below.
PRIVATE_KEY=

# Testnet: set GOVERNANCE_ADDRESS to your deployer EOA (owns OFTs / Station).
# Mainnet: prefer TIMELOCK_ADDRESS after DeployStLighterTimelock.
ADMIN_ADDRESS=
GOVERNANCE_ADDRESS=
TIMELOCK_ADDRESS=
TIMELOCK_MIN_DELAY=172800
MULTISIG_ADDRESS=
MAX_BUMP_TIP=0

# LayerZero Endpoint V2 + eids (fill from LZ docs / endpoint.eid())
LZ_ENDPOINT_HORIZEN=
LZ_ENDPOINT_BASE=
HORIZEN_EID=40435  #horizentestnet
BASE_EID=40245 #base sepolia

# =============================================================================
# Phase A — Horizen hub
# =============================================================================
# A1 DeployZenTokenOFT → paste into ZEN_TOKEN_ADDRESS (Horizen native OFT = ZEN)
ZEN_TOKEN_ADDRESS=

# A2 DeployZenStaker
ZEN_STAKER_ADDRESS=

# A4 DeployStLighterHorizen → paste proxy
STLIGHTER_PROXY_ADDRESS=
LT_ZEN_HORIZEN=

# A5 DeployInboundStation
INBOUND_STATION_ADDRESS=

# Phase G — DeployEgressStation (Wave B; after C1 ZEN peers)
# EGRESS_STATION_ADDRESS=
# ZEN_OFT_STATION_BRIDGE_ADDRESS=

# =============================================================================
# Phase B — Base Sepolia spoke
# =============================================================================
# B1 DeployMockZEN (Base only — do NOT use MockZEN as Horizen stake asset)
BASE_ZEN_TOKEN_ADDRESS=

# B2 DeployZenTokenOFTAdapter
BASE_ZEN_ADAPTER=

# B3 DeployStLighterBase
LT_ZEN_BASE=
LZ_ENDPOINT_BASE=

# =============================================================================
# Phase C — OFT wiring (run per chain / per OApp)
# =============================================================================
# ltZEN peers (WireStLighterOFT)
LT_ZEN_LOCAL=
PEER_EID=
PEER_LT_ZEN=

# ZEN Adapter ↔ ZenTokenOFT peers (WireZenOft)
ZEN_OFT_LOCAL=
PEER_ZEN_OFT=

# ULN / DVN (ConfigureStLighterOFTDVN) — use OAPP_LOCAL for ltZEN or ZEN OFT/adapter
OAPP_LOCAL=
LZ_ENDPOINT=
LZ_SEND_LIB=
LZ_RECEIVE_LIB=
LZ_CONFIRMATIONS=
DVN_ADDRESSES=
DVN_OPTIONAL_ADDRESSES=
DVN_OPTIONAL_THRESHOLD=0

# -- E2E helper keys (scripts/e2e-zen-staking.js) -----------------------------
RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
USER1_PRIVATE_KEY=
USER2_PRIVATE_KEY=
