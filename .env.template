MAINNET_RPC_URL=
FOUNDRY_PROFILE=default
DEPLOYER_PRIVATE_KEY=
PROPOSER_ADDRESS=

# =============================================================================
# Horizen testnet deploy — run in this order (each step fills the next var)
# =============================================================================
#   PRIVATE_KEY is the deployer key used by ALL forge scripts below.
PRIVATE_KEY=

# Step 1 — MockZEN faucet token:  forge script script/DeployMockZEN.s.sol
#   Output -> paste the printed MockZEN address into ZEN_TOKEN_ADDRESS.
ZEN_TOKEN_ADDRESS=

# Step 2 — ZenStaker:  forge script script/DeployZenStaker.s.sol
#   Needs ZEN_TOKEN_ADDRESS (step 1) + ADMIN_ADDRESS (staker admin; your EOA on testnet).
#   Output -> paste the printed ZenStaker address into ZEN_STAKER_ADDRESS.
ADMIN_ADDRESS=
MAX_BUMP_TIP=0
ZEN_STAKER_ADDRESS=

# Step 3 — LtZEN + StLighter (hub):  forge script script/DeployStLighterHorizen.s.sol
#   Needs ZEN_TOKEN_ADDRESS, ZEN_STAKER_ADDRESS, and the Horizen LayerZero V2 Endpoint.
#   On testnet, GOVERNANCE_ADDRESS (below) may be your EOA instead of a timelock.
LZ_ENDPOINT_HORIZEN=

# stLighter governance (Phase 2)
MULTISIG_ADDRESS=
TIMELOCK_ADDRESS=
TIMELOCK_MIN_DELAY=172800
GOVERNANCE_ADDRESS=

# stLighter OFT wiring (Phase 3) — copy DVN from ZenTokenOFT on Horizen
LT_ZEN_LOCAL=
PEER_EID=
PEER_LT_ZEN=
LZ_ENDPOINT=
LZ_SEND_LIB=
LZ_RECEIVE_LIB=
LZ_CONFIRMATIONS=
DVN_ADDRESSES=

# -- E2E testnet script (scripts/e2e-zen-staking.js) --------------------------
RPC_URL=http://horizen-testnet.rpc.caldera.xyz/http                   # testnet RPC, e.g. https://eon-rpc.horizen.io
USER1_PRIVATE_KEY=         # first test user (must have enough ETH or deployer will top up)
USER2_PRIVATE_KEY=         # second test user

